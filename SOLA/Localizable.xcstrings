          "stringUnit": {
            "state": "translated",
            "value": "Once you close this offer, it's gone.\nOne payment, lifetime access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez cierres esta oferta, desaparece.\nUn solo pago, acceso de por vida."
