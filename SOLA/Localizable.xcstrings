          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti raramente e ti abbronzi facilmente fino a una tonalità caramello."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raramente queimas e bronzeias facilmente até um tom caramelo."
          }
        }
      }
    },
    "Tu brûles systématiquement et ne bronzes presque jamais. La prudence est essentielle.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
