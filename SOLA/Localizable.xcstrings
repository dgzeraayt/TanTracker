    "+%lld points d'indice depuis le début. Continue à ce rythme, ta teinte se construit en douceur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld index points since the start. Keep this pace and your tan builds up gently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld puntos de índice desde el inicio. Sigue así y tu bronceado se construye con suavidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld punti di indice dall'inizio. Continua così e la tua abbronzatura cresce con dolcezza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld pontos de índice desde o início. Continua assim e o teu bronzeado constrói-se com suavidade."
          }
        }
      }
    },
    "+%lld pts d'indice": {
      "localizations": {
