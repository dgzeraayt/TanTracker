          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizamos logo a seguir."
          }
        }
      }
    },
    "On perçoit un soupçon de rougeur sur ta peau.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On perçoit un soupçon de rougeur sur ta peau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a hint of redness on your skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se percibe un toque de rojez en tu piel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si percepisce un accenno di rossore sulla tua pelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Percebe-se um toque de vermelhidão na tua pele."
          }
        }
      }
    },
    "On renforcera les alertes en conséquence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll strengthen alerts accordingly."
