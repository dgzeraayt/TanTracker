    "Avec ta crème, tu peux rester %lld min. Sinon, vise le créneau plus doux : %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Avec ta crème, tu peux rester %1$lld min. Sinon, vise le créneau plus doux : %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With sunscreen, you can stay %1$lld min. Otherwise, aim for the gentler window: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con protector, puedes quedarte %1$lld min. Si no, busca la franja más suave: %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la crema, puoi restare %1$lld min. Altrimenti, punta alla fascia più dolce: %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com protetor, podes ficar %1$lld min. Caso contrário, escolhe a janela mais suave: %2$@."
          }
        }
      }
    },
