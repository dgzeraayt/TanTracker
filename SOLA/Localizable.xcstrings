    "Tu approches de ta dose sûre (encore ~%lld min). Pense à te couvrir ou à chercher l'ombre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're nearing your safe dose (~%lld min left). Consider covering up or finding shade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te acercas a tu dosis segura (~%lld min restantes). Piensa en cubrirte o buscar sombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti stai avvicinando alla dose sicura (~%lld min rimasti). Pensa a coprirti o cercare l'ombra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a aproximar-te da tua dose segura (~%lld min restantes). Pensa em cobrir-te ou procurar sombra."
          }
        }
      }
    },
    "Tu approches de ta limite du jour.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're nearing your daily limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te acercas a tu límite del día."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti stai avvicinando al limite del giorno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a aproximar-te do teu limite do dia."
          }
        }
      }
    },
    "Tu brûles facilement et bronzes légèrement. Une exposition progressive te protège.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You burn easily and tan slightly. Gradual exposure protects you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quemas con facilidad y te bronceas ligeramente. Una exposición progresiva te protege."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti facilmente e ti abbronzi leggermente. Un'esposizione graduale ti protegge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queimas com facilidade e bronzeias ligeiramente. Uma exposição gradual protege-te."
          }
        }
      }
    },
    "Tu brûles légèrement puis bronzes joliment. Ton bronzage doré est très accessible — avec la bonne dose d'UV.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You burn slightly then tan nicely. A golden tan is well within reach — with the right UV dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quemas ligeramente y luego te bronceas bien. Un bronceado dorado está a tu alcance — con la dosis de UV adecuada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti leggermente poi ti abbronzi bene. Un'abbronzatura dorata è alla tua portata — con la giusta dose di UV."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queimas ligeiramente e depois bronzeias bem. Um bronzeado dourado está ao teu alcance — com a dose certa de UV."
          }
        }
      }
    },
    "Tu brûles rarement et bronzes facilement vers une teinte caramel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You rarely burn and tan easily to a caramel shade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara vez te quemas y te bronceas fácilmente hasta un tono caramelo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti raramente e ti abbronzi facilmente fino a una tonalità caramello."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raramente queimas e bronzeias facilmente até um tom caramelo."
          }
        }
      }
    },
    "Tu brûles systématiquement et ne bronzes presque jamais. La prudence est essentielle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You always burn and almost never tan. Caution is essential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre te quemas y casi nunca te bronceas. La prudencia es esencial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti sempre e non ti abbronzi quasi mai. La prudenza è essenziale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queimas sempre e quase nunca bronzeias. A prudência é essencial."
          }
        }
      }
    },
    "Tu brûles très rarement et bronzes intensément.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You very rarely burn and tan intensely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quemas muy rara vez y te bronceas intensamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti scotti molto raramente e ti abbronzi intensamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queimas muito raramente e bronzeias intensamente."
          }
        }
      }
    },
    "Tu connais ta fenêtre idéale chaque jour.\nFini les coups de soleil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know your ideal window every day.\nNo more sunburns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoces tu franja ideal cada día.\nSe acabaron las quemaduras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosci la tua fascia ideale ogni giorno.\nBasta scottature."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheces a tua janela ideal todos os dias.\nAcabaram-se as queimaduras."
          }
        }
      }
    },
    "Tu es au soleil depuis 1h40. Remets une couche dans 20 min.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been in the sun for 1h40. Reapply in 20 min."
