    "Goldn calcule l'indice UV de ta région et te dit quand c'est le bon moment pour bronzer. Pas de devinette, juste de la science.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calculates your area's UV index and tells you when it's the right time to tan. No guesswork, just science."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calcula el índice UV de tu zona y te dice cuándo es el buen momento para broncearte. Sin adivinar, solo ciencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calcola l'indice UV della tua zona e ti dice quando è il momento giusto per abbronzarti. Niente indovinelli, solo scienza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Goldn calcula o índice UV da tua zona e diz-te quando é a altura certa para bronzear. Sem adivinhas, só ciência."
          }
        }
      }
    },
    "Goldn calcule ta dose sûre du jour et t'alerte avant la brûlure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calculates your safe daily dose and alerts you before you burn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calcula tu dosis segura diaria y te avisa antes de quemarte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn calcola la tua dose sicura giornaliera e ti avvisa prima della scottatura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Goldn calcula a tua dose segura diária e avisa-te antes de queimares."
          }
        }
      }
    },
    "Goldn suit ton bronzage en temps réel et t'affiche tes progrès vers ta teinte rêvée. Tu sais exactement où tu en es.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn tracks your tan in real time and shows your progress toward your dream shade. You know exactly where you stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn sigue tu bronceado en tiempo real y te muestra tu progreso hacia tu tono soñado. Sabes exactamente dónde estás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn monitora la tua abbronzatura in tempo reale e mostra i progressi verso la tonalità dei tuoi sogni. Sai esattamente a che punto sei."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Goldn acompanha o teu bronzeado em tempo real e mostra o teu progresso até ao tom dos teus sonhos. Sabes exatamente onde estás."
          }
        }
      }
    },
    "Goldn t'enverra des rappels intelligents — uniquement utiles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn will send you smart reminders — only useful ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn te enviará recordatorios inteligentes — solo los útiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldn ti invierà promemoria intelligenti — solo quelli utili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Goldn vai enviar-te lembretes inteligentes — só os úteis."
          }
        }
      }
    },
