    "Garde ton UV du jour et ton temps de bronzage sûr à portée de regard, sans ouvrir l'app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep today's UV and your safe tanning time at a glance, without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten a la vista el UV de hoy y tu tiempo de bronceado seguro, sin abrir la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni a portata di sguardo l'UV di oggi e il tuo tempo di abbronzatura sicuro, senza aprire l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem à vista o UV de hoje e o teu tempo de bronzeamento seguro, sem abrir a app."
          }
        }
      }
    },
