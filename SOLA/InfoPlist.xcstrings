        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldn utilise l'appareil photo pour analyser ta peau et suivre l'évolution de ton bronzage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldn usa la fotocamera per analizzare la tua pelle e monitorare l'evoluzione della tua abbronzatura."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Goldn usa a câmera para analisar a tua pele e acompanhar a evolução do teu bronzeado."
          }
        }
      }
    },
