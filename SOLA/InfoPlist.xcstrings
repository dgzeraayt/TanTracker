    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldn uses the camera to analyze your skin and track your tan progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldn usa la cámara para analizar tu piel y seguir la evolución de tu bronceado."
